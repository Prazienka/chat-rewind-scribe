# Supabase (Project Settings → API). URL a publishable klíč jsou veřejné.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Gemini (Google AI Studio → Get API key) – jen na serveru, nikdy s předponou VITE_
GEMINI_API_KEY=...
# Volitelné: modely v pořadí, v jakém se zkoušejí (při přetížení se přejde na další)
# GEMINI_TEXT_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
# GEMINI_TRANSCRIBE_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite
