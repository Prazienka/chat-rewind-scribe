# Supabase (Project Settings → API). URL a publishable klíč jsou veřejné.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Gemini (Google AI Studio → Get API key) – jen na serveru, nikdy s předponou VITE_
GEMINI_API_KEY=...
# Volitelné: změna modelů
# GEMINI_TEXT_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# GEMINI_TRANSCRIBE_MODEL=gemini-3.8-flash
