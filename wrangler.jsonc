// Nasazení na Cloudflare Workers. Build: `npm run build`, nasazení: `npm run deploy`
// (nebo automaticky z GitHubu přes Cloudflare Workers Builds).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chat-scribe",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-01",
  // process.env v serverovém kódu se plní z proměnných a tajných klíčů workeru.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  // Veřejné údaje Supabase pro server. OPENAI_API_KEY se zadává jako tajný klíč
  // (Cloudflare → Worker → Settings → Variables and Secrets), nikdy sem.
  "vars": {
    "SUPABASE_URL": "https://dglurxjmmryietkmxcku.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_lA2RJmUu5cUcx-0i80ywnA_5dJCk15e"
  },
  "observability": { "enabled": true }
}
